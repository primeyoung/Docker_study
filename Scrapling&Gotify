🛒 电商价格监控系统（全平台通用版）统一开发规范文档


1. 跨平台运行与多环境切换（Windows / Linux / Docker）

系统通过 ENV_MODE（区分本地/云端）和 RUN_PLATFORM（区分系统架构）进行双维度动态调节。

⚙️ 环境配置文件 (config.py)

python
import os
import sys
from pathlib import Path

# 统一跨平台路径（使用 pathlib 自动适配 Windows '\' 与 Linux '/'）
BASE_DIR = Path(__file__).resolve().parent
DB_PATH = BASE_DIR / "data" / "monitor.db"
COOKIE_PATH = BASE_DIR / "config" / "cookies_store.json"

class Config:
    GOTIFY_URL = os.getenv("GOTIFY_URL", "https://your-public-gotify-domain.com")
    GOTIFY_TOKEN = os.getenv("GOTIFY_TOKEN", "your-app-token")
    IGNORE_SSL_ERRORS = os.getenv("IGNORE_SSL_ERRORS", "True").lower() == "true"
    
    # 动态检测当前平台：WINDOWS, LINUX, DOCKER
    if os.path.exists("/.dockerenv"):
        PLATFORM = "DOCKER"
    else:
        PLATFORM = "WINDOWS" if sys.platform.startswith("win") else "LINUX"

    # 环境模式调节：LOCAL (本地调试) 或 CLOUD (云端生产)
    ENV_MODE = os.getenv("ENV_MODE", "LOCAL")

    @classmethod
    def get_browser_args(cls):
        """生成跨平台、防爆内存的 Scrapling 隐形参数"""
        flags = [
            "--disable-blink-features=AutomationControlled",
            "--no-sandbox",
            "--disable-gpu"
        ]
        
        # 容器及 Linux 云环境下的核心优化（2核4G VPS 内存守门员配置）
        if cls.PLATFORM in ["DOCKER", "LINUX"] or cls.ENV_MODE == "CLOUD":
            flags.extend([
                "--disable-dev-shm-usage",     # 极其重要：防止容器/无界界面内共享内存写满崩溃
                "--disable-software-rasterizer",
                "--single-process"             # 2核4G 环境下，强制减少 Chromium 衍生子进程
            ])
            cls.HEADLESS = True
            cls.USE_PROXY = True
            cls.MAX_CONCURRENT_TASKS = 1      # 严格串行抓取，保护内存
        else:
            # Windows 或本地桌面环境调试模式
            cls.HEADLESS = False              # 允许前台弹窗，方便检查滑块或 Cookie
            cls.USE_PROXY = False             # 走本地宽带
            cls.MAX_CONCURRENT_TASKS = 2
            
        return flags

